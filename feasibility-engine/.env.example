# Backend (FastAPI / feasibility-engine) — paste into your hosting dashboard (e.g. Render → Environment)
# Also create a local copy as feasibility-engine/.env (already gitignored)

# Controls which data adapter the feasibility engine uses.
# Options: "mappls" (live Mappls Nearby API) | "mock" (hardcoded fixture data)
FEASIBILITY_DATA_SOURCE=mock

# Controls SWOT synthesis method.
# Options: "gemini" (Google Gemini AI) | "template" (static template fallback)
FEASIBILITY_SYNTHESIS=template

# Your Mappls API key for backend use (Nearby Places API calls)
# Get from: console.mappls.com → Keys
MAPPLS_API_KEY=

# Your Google Gemini API key (only needed if FEASIBILITY_SYNTHESIS=gemini)
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this backend (CORS).
# Must include your deployed frontend URL once you have it.
# Example: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
